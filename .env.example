# CMS (Jigglycard-CMS) — unico backend del sito.
# La chiave storefront resta lato server: il browser non la vede mai, tutte le
# chiamate passano dalle rotte server/api/shop/*.
CMS_STOREFRONT_URL=http://localhost:3000
CMS_STOREFRONT_KEY=change_me

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# URL di ritorno dopo il pagamento (pagina acquisto-completato)
PURCHASE_COMPLETED_URL=http://localhost:3010/acquisto-completato

# SendGrid (newsletter e modulo assistenza)
SENDGRID_API_TOKEN=change_me
ADMIN_MAIL=info@example.com
NEWSLETTER_TO_MAIL=info@example.com
NEWSLETTER_TO_NAME=Jigglycard
