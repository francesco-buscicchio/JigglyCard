# CMS (Jigglycard-CMS) — unico backend del sito.
# La chiave storefront resta lato server: il browser non la vede mai, tutte le
# chiamate passano dalle rotte server/api/shop/*.
NUXT_CMS_STOREFRONT_URL=http://localhost:3000
NUXT_CMS_STOREFRONT_KEY=change_me

# Stripe
NUXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
NUXT_STRIPE_SECRET_KEY=sk_test_...
# Segreto del webhook Stripe (in locale: stripe listen --forward-to localhost:3010/api/shop/stripe/webhook)
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
# URL di ritorno dopo il pagamento (pagina acquisto-completato)
NUXT_PUBLIC_PURCHASE_COMPLETED_URL=http://localhost:3010/acquisto-completato

NUXT_PUBLIC_ADMIN_MAIL=info@example.com

# Email (casella Aruba): conferme d'ordine e modulo di assistenza
NUXT_SMTP_HOST=smtps.aruba.it
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=change_me
NUXT_SMTP_PASS=change_me
NUXT_MAIL_FROM=change_me
